{"input": {"_script": "\nusing Base64\nroot = mktempdir(get(ENV, \"WORK\", \"/tmp\"))\nwrite(joinpath(root, \"p.tgz\"), base64decode(\"\"))\nrun(`tar -xzf $(joinpath(root, \"p.tgz\")) -C $root`)\ndir = joinpath(root, \"b\")\n\nmps = false\nenvs = Dict{String,String}()\nmpsdir = joinpath(root, \"mps\")\nif mps\n    mkpath(mpsdir)\n    envs[\"CUDA_MPS_PIPE_DIRECTORY\"] = mpsdir; envs[\"CUDA_MPS_LOG_DIRECTORY\"] = joinpath(mpsdir, \"log\")\n    exe = Sys.which(\"nvidia-cuda-mps-control\")\n    if exe === nothing\n        println(\"RESULT_JSON {\\\"error\\\": \\\"nvidia-cuda-mps-control not found\\\"}\"); exit(0)\n    end\n    run(setenv(`$exe -d`, merge(Dict(ENV), envs)))\n    sleep(3)\nend\nxfl = mps ? [\\\"-x\\\", \\\"CUDA_MPS_PIPE_DIRECTORY\\\", \\\"-x\\\", \\\"CUDA_MPS_LOG_DIRECTORY\\\"] : String[]\ncmd = setenv(`mpirun --oversubscribe -np 32 $xfl julia --startup-file=no $(joinpath(dir, \"bench1gpu.jl\")) rank $dir`, merge(Dict(ENV), envs))\nerrf = joinpath(dir, \"err.txt\")\nout = read(pipeline(ignorestatus(cmd); stderr = errf), String)\nerrtxt = isfile(errf) ? read(errf, String) : \"\"\nif mps\n    try run(pipeline(setenv(`$(Sys.which(\"nvidia-cuda-mps-control\"))`, merge(Dict(ENV), envs)); stdin = IOBuffer(\"quit\\n\"))) catch; end\nend\ni = findlast(\"RESULT_JSON \", out)\nprintln(i === nothing ? \"{\\\"error\\\": \\\"no result\\\", \\\"tail\\\": \\\"STDERR: \" * replace(last(errtxt, min(length(errtxt), 1500)), \"\\\"\" => \"'\", \"\\n\" => \" | \") * \" STDOUT: \" * replace(last(out, min(length(out), 500)), \"\\\"\" => \"'\", \"\\n\" => \" | \") * \"\\\"}\" : strip(out[i+12:end]))\n", "_topology": "gpu_v100"}}