{"input": {"_script": "\nusing Base64\nconst SCRIPTS = Dict{String,String}(\"ctl2_v26h_mlp3\" => \"\", \"ctl2_v26h_mlp3_push\" => \"\")\nfunction runone(name, b64)\n    dir = mktempdir(); gz = joinpath(dir, name * \".jl.gz\"); f = joinpath(dir, name * \".jl\")\n    write(gz, base64decode(b64)); run(pipeline(`gunzip -c $gz`, stdout = f))\n    so = joinpath(dir, \"out.txt\"); se = joinpath(dir, \"err.txt\")\n    t0 = time()\n    proc = run(pipeline(ignorestatus(`$(Base.julia_cmd()) --project=$(Base.active_project()) $f`); stdout = so, stderr = se))\n    el = time() - t0\n    lines = filter(!isempty, split(read(so, String), \"\\n\"))\n    last = isempty(lines) ? \"\" : String(lines[end])\n    err = read(se, String)\n    return Dict(\"name\" => name, \"exit\" => proc.exitcode, \"seconds\" => round(el; digits = 1), \"last_line\" => last,\n                \"stderr_tail\" => err[max(1, end - 1500):end])\nend\nfunction main()\n    res = Any[]\n    for n in sort(collect(keys(SCRIPTS)))\n        push!(res, runone(n, SCRIPTS[n]))\n    end\n    s = \"{\\\"host\\\":\\\"\" * gethostname() * \"\\\",\\\"runs\\\":[\" * join([\n        \"{\\\"name\\\":\\\"\" * r[\"name\"] * \"\\\",\\\"exit\\\":\" * string(r[\"exit\"]) * \",\\\"seconds\\\":\" * string(r[\"seconds\"]) *\n        \",\\\"result\\\":\" * (startswith(r[\"last_line\"], \"{\") ? r[\"last_line\"] : \"null\") *\n        \",\\\"stderr_tail\\\":\" * repr(r[\"stderr_tail\"]) * \"}\" for r in res], \",\") * \"]}\"\n    println(s)\nend\nmain()\n", "_topology": "gpu_v100"}}