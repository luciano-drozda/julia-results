{"input": {"_script": "\nusing Base64\nroot = mktempdir(get(ENV, \"WORK\", \"/tmp\"))\nwrite(joinpath(root, \"p.tgz\"), base64decode(\"\"))\nrun(`tar -xzf $(joinpath(root, \"p.tgz\")) -C $root`)\ndir = joinpath(root, \"b\")\n\ncmd = `mpirun --oversubscribe -np 32 julia --startup-file=no $(joinpath(dir, \"bench1gpu.jl\")) rank $dir`\nerrf = joinpath(dir, \"err.txt\")\nout = read(pipeline(ignorestatus(cmd); stderr = errf), String)\nerrtxt = isfile(errf) ? read(errf, String) : \"\"\nlines = filter(l -> startswith(l, \"{\"), split(out, \"\\n\"))\nprintln(isempty(lines) ? \"{\\\"error\\\": \\\"no JSON from rank 0\\\", \\\"tail\\\": \\\"\" * replace(\"STDERR: \" * last(errtxt, min(length(errtxt), 1800)) * \" STDOUT: \" * last(out, min(length(out), 600)), \"\\\"\" => \"'\", \"\\n\" => \" | \") * \"\\\"}\" : last(lines))\n", "_topology": "gpu_v100"}}