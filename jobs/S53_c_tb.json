{"input": {"_script": "\nusing Base64\nconst PAYLOAD = \"\"\nconst DEADLINE = 600.0\nconst HARD = DEADLINE + 60.0\nconst CAP = 420.0\nconst STALL = 150.0\nconst CHILD = String(base64decode(\"\"))\nfunction unxz(src, dst)\n    if Sys.which(\"xz\") !== nothing && get(ENV, \"STADE_FORCE_7Z\", \"\") != \"1\"\n        run(pipeline(`xz -dc $src`, stdout = dst))\n    else\n        Core.eval(Main, :(import p7zip_jll))\n        p7 = Base.invokelatest(() -> Main.p7zip_jll.p7zip())\n        run(pipeline(`$p7 x -txz -so $src`, stdout = dst))\n    end\nend\nfunction unbundle()\n    dir = mktempdir(); xz = joinpath(dir, \"b.xz\"); raw = joinpath(dir, \"b.bin\")\n    write(xz, base64decode(PAYLOAD)); unxz(xz, raw)\n    blob = read(raw); out = Pair{String,Vector{UInt8}}[]; pos = 1\n    while pos <= length(blob)\n        e1 = findnext(==(0x0a), blob, pos); name = String(blob[pos:e1 - 1])\n        e2 = findnext(==(0x0a), blob, e1 + 1); len = parse(Int, String(blob[e1 + 1:e2 - 1]))\n        push!(out, name => blob[e2 + 1:e2 + len]); pos = e2 + len + 1\n    end\n    return out\nend\nrowjson(r) = \"{\\\"name\\\":\\\"\" * r[\"name\"] * \"\\\",\\\"exit\\\":\" * string(r[\"exit\"]) * \",\\\"seconds\\\":\" * string(r[\"seconds\"]) * \",\\\"skipped\\\":\" * string(r[\"skipped\"]) *\n             \",\\\"result\\\":\" * (startswith(r[\"last_line\"], \"{\") ? r[\"last_line\"] : \"null\") * \",\\\"stderr_tail\\\":\" * repr(r[\"stderr_tail\"]) * \"}\"\nfunction runone(name, bytes, cap)\n    dir = mktempdir(); f = joinpath(dir, name * \".jl\"); write(f, bytes)\n    so = joinpath(dir, \"out.txt\"); se = joinpath(dir, \"err.txt\")\n    t0 = time()\n    proc = run(pipeline(ignorestatus(`timeout -k 5 $(round(Int, cap)) $(Base.julia_cmd()) --project=$(Base.active_project()) $f`); stdout = so, stderr = se))\n    el = time() - t0\n    lines = filter(!isempty, split(read(so, String), \"\\n\"))\n    last = isempty(lines) ? \"\" : String(lines[end])\n    err = read(se, String)\n    return Dict(\"name\" => name, \"exit\" => proc.exitcode, \"seconds\" => round(el; digits = 1), \"last_line\" => last,\n                \"stderr_tail\" => err[max(1, end - 1500):end], \"skipped\" => false)\nend\nskipped(n, why) = Dict(\"name\" => n, \"exit\" => -1, \"seconds\" => 0.0, \"last_line\" => \"\", \"stderr_tail\" => \"skipped: \" * why, \"skipped\" => true)\n# an in-process batch: restarts the child after a crash or a stall, until every script has a row or time is out\nfunction runbatch(items, t00)\n    res = Any[]; todo = copy(items)\n    dir = mktempdir(); cf = joinpath(dir, \"child.jl\"); write(cf, CHILD)\n    while !isempty(todo)\n        if time() - t00 > DEADLINE\n            for (n, _) in todo; push!(res, skipped(n, \"deadline\")); end\n            break\n        end\n        man = joinpath(dir, \"manifest.txt\"); resf = joinpath(dir, \"res.jsonl\"); rm(resf; force = true)\n        open(man, \"w\") do io\n            for (n, b) in todo\n                p = joinpath(dir, n * \".jl\"); write(p, b); println(io, n, \"\\t\", p)\n            end\n        end\n        so = joinpath(dir, \"child.out\"); se = joinpath(dir, \"child.err\")\n        proc = run(pipeline(`$(Base.julia_cmd()) --project=$(Base.active_project()) $cf $man $resf`; stdout = so, stderr = se); wait = false)\n        last_n = 0; last_t = time()\n        while process_running(proc)\n            sleep(2.0)\n            n = isfile(resf) ? countlines(resf) : 0\n            if n != last_n; last_n = n; last_t = time(); end\n            if time() - last_t > STALL || time() - t00 > HARD\n                kill(proc); sleep(1.0); process_running(proc) && kill(proc, Base.SIGKILL)\n                break\n            end\n        end\n        wait(proc)\n        rows = isfile(resf) ? filter(!isempty, readlines(resf)) : String[]\n        done = Set{String}()\n        for l in rows\n            nm = match(r\"\\\"name\\\":\\\"([^\\\"]*)\\\"\", l).captures[1]\n            push!(done, nm)\n            push!(res, Dict(\"rawrow\" => l, \"name\" => nm))\n        end\n        rest = [(n, b) for (n, b) in todo if !(n in done)]\n        if !isempty(rest)\n            code = proc.exitcode\n            stalled = (time() - last_t > STALL) || (time() - t00 > HARD)\n            n1 = rest[1][1]\n            errtxt = isfile(se) ? (s = read(se, String); s[max(1, end - 1500):end]) : \"\"\n            push!(res, Dict(\"name\" => n1, \"exit\" => stalled ? 124 : (code == 0 ? 99 : code), \"seconds\" => 0.0, \"last_line\" => \"\", \"stderr_tail\" => (stalled ? \"stalled or out of time; \" : \"child died; \") * errtxt, \"skipped\" => false))\n            rest = rest[2:end]\n        end\n        todo = rest\n    end\n    return res\nend\nfunction main()\n    t00 = time()\n    items = try unbundle() catch e; println(\"{\\\"host\\\":\\\"\" * gethostname() * \"\\\",\\\"error\\\":\" * repr(sprint(showerror, e)) * \",\\\"runs\\\":[]}\"); return end\n    iso = sort([(n, b) for (n, b) in items if !startswith(n, \"P_\")]; by = first)\n    inp = sort([(n, b) for (n, b) in items if startswith(n, \"P_\")]; by = first)\n    rows = String[]\n    for (n, b) in iso\n        r = time() - t00 > DEADLINE ? skipped(n, \"deadline\") : runone(n, b, max(30.0, min(CAP, HARD - (time() - t00))))\n        push!(rows, rowjson(r))\n    end\n    if !isempty(inp)\n        for r in runbatch(inp, t00)\n            push!(rows, haskey(r, \"rawrow\") ? replace(r[\"rawrow\"], r\"^\\{\" => \"{\\\"skipped\\\":false,\") : rowjson(r))\n        end\n    end\n    println(\"{\\\"host\\\":\\\"\" * gethostname() * \"\\\",\\\"total_seconds\\\":\" * string(round(time() - t00; digits = 1)) * \",\\\"runs\\\":[\" * join(rows, \",\") * \"]}\")\nend\nmain()\n", "_topology": "gpu_v100"}}